        "id": "text-7",
        "value": "Valor Presente Neto (VPN) y Tasa Interna de Retorno (TIR) Verde."
      },
      {
        "id": "text-8",
        "value": "Mercados de carbono, bonos sustentables y tributación ambiental."
      },
      {
        "id": "text-9",
        "value": "Diseño circular e innovación en cadenas de suministro."
      },
      {
        "id": "text-10",
        "value": "Cátedra con enfoque en los Objetivos de Desarrollo Sostenible (ODS - Agenda 2030)."
      },
      {
        "id": "text-11",
        "value": "Módulos del Curso"
      },
      {
        "id": "text-12",
        "value": "Lectura Complementaria"
      },
      {
        "id": "text-13",
        "value": "Informes de organismos internacionales (CEPAL, Banco Mundial, IRENA) sobre economía y desarrollo sustentable."
      },
      {
        "id": "text-14",
        "value": "Acceder a lecturas"
      },
      {
        "id": "text-15",
        "value": "Presentaciones de Cátedra"
      },
      {
        "id": "text-16",
