rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // REQUISITO DE ACCESO: Dominio institucional UVM o correo docente autorizado
    function isAllowedEmail() {
      return isAuthenticated() &&
        request.auth.token.email != null &&
        (request.auth.token.email.matches('.*@my[.]uvm[.]edu[.]mx$') ||
         request.auth.token.email == 'lrodricg30@gmail.com');
    }

    function isInstitutionalEmail() {
      return isAllowedEmail();
    }

    function isUser(uid) {
      return isAllowedEmail() && request.auth.uid == uid;
    }

    // Identificar a la maestra (autorizada por correo)
    function isTeacher() {
      return isAuthenticated() &&
        request.auth.token.email != null &&
        (request.auth.token.email == 'lrodricg30@gmail.com' ||
         request.auth.token.email == 'xochitl_zapatam@my.uvm.edu.mx');
    }

    // 1. Colección de Perfiles de Usuarios
    match /users/{userId} {
      allow read: if isUser(userId) || isTeacher();
      allow create: if isUser(userId) &&
        request.resource.data.uid == userId &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.role == (isTeacher() ? 'teacher' : 'student') &&
        request.resource.data.classIds == [] &&
        request.resource.data.requestedClassIds == [] &&
        request.resource.data.stampsBalance == 0 &&
        request.resource.data.totalStampsEarned == 0;
      allow update: if isTeacher() || (isUser(userId) &&
        resource.data.role == 'student' && resource.data.onboardingComplete == false &&
        request.resource.data.onboardingComplete == true &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['requestedClassIds', 'onboardingComplete', 'enrollmentStatus', 'updatedAt']) &&
        request.resource.data.requestedClassIds is list &&
        request.resource.data.requestedClassIds.size() > 0 &&
        request.resource.data.requestedClassIds.size() <= 8 &&
        request.resource.data.enrollmentStatus == 'pending') ||
        (isUser(userId) && resource.data.role == 'student' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stampsBalance', 'totalStampsEarned']) &&
          request.resource.data.stampsBalance == resource.data.stampsBalance + 1 &&
          request.resource.data.totalStampsEarned == resource.data.totalStampsEarned + 1);
      allow delete: if isTeacher();
    }

    // 2. Colección de Clases impartidas por la Maestra
    match /classes/{classId} {
      allow read: if isInstitutionalEmail();
      allow write: if isTeacher();
    }

    // 3. Tipos / Catálogo de Sellos Formativos
    match /stampTypes/{stampTypeId} {
      allow read: if isInstitutionalEmail();
      allow write: if isTeacher();
    }

    // 4. Códigos QR generados para otorgar sellos
    match /qrCodes/{qrId} {
      allow read: if isInstitutionalEmail();
      allow create, delete: if isTeacher();
      allow update: if isTeacher() || (isUser(request.auth.uid) &&
        resource.data.active == true && request.resource.data.active == false &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimedBy', 'claimedCount']) &&
        request.resource.data.claimedBy.hasAll(resource.data.claimedBy) &&
        request.resource.data.claimedBy.size() == resource.data.claimedBy.size() + 1 &&
        request.resource.data.claimedBy.hasAll([request.auth.uid]) &&
        request.resource.data.claimedCount == resource.data.claimedCount + 1);
    }

    // 5. Historial de Reclamaciones de Sellos
    match /claims/{claimId} {
      allow read: if isInstitutionalEmail() && (resource.data.studentUid == request.auth.uid || isTeacher());
      allow create: if isTeacher() || (isUser(request.resource.data.studentUid) && request.resource.data.studentUid == request.auth.uid);
      allow update, delete: if isTeacher();
    }

    // 6. Historial de Canjes en la Tienda
    match /purchases/{purchaseId} {
      allow read: if isInstitutionalEmail() && (resource.data.studentUid == request.auth.uid || isTeacher());
      allow create: if isTeacher();
      allow update, delete: if isTeacher();
    }
    match /shopSettings/{id} {
      allow read: if isInstitutionalEmail();
      allow write: if isTeacher();
    }
    match /shopItems/{id} {
      allow read: if isInstitutionalEmail();
      allow write: if isTeacher();
    }
    match /shopCategories/{id} {
      allow read: if isInstitutionalEmail();
      allow write: if isTeacher();
    }
    match /calendarEvents/{id} {
      allow read: if isInstitutionalEmail();
      allow write: if isTeacher();
    }
    match /calendarSettings/{id} {
      allow read: if isInstitutionalEmail();
      allow write: if isTeacher();
    }
    match /calendarLegend/{id} {
      allow read: if isInstitutionalEmail();
      allow write: if isTeacher();
    }
    match /documents/{id} {
      allow read: if (isInstitutionalEmail() && resource.data.published == true) || isTeacher();
      allow write: if isTeacher();
    }
    match /coursePages/{id} {
      allow read: if isInstitutionalEmail();
      allow write: if isTeacher();
    }
  }
}
